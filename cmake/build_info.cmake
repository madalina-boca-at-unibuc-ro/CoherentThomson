# Writes the build-provenance source file read by Core::BuildInfo (src/core/include/build_info/build_info.hpp):
# git commit, dirty state, the uncommitted changes as a patch (untracked files included), compiler, flags and the
# building host. Run as `cmake -P` on every build (custom target in src/core/CMakeLists.txt) and once at configure
# time. OUTPUT is rewritten only when its content changes, so a build with nothing new doesn't recompile or relink.
#
# Inputs (-D): SOURCE_DIR, OUTPUT, COMPILER, CXX_FLAGS, BUILD_TYPE.

cmake_minimum_required(VERSION 3.21)

# C++ string literal for an arbitrary CMake string.
function(to_cpp_literal input out_var)
  string(REPLACE "\\" "\\\\" s "${input}")
  string(REPLACE "\"" "\\\"" s "${s}")
  string(REPLACE "\n" "\\n" s "${s}")
  set(${out_var} "\"${s}\"" PARENT_SCOPE)
endfunction()

# Read-only git: --no-optional-locks keeps `status` from refreshing .git/index (the laptops sync .git via Dropbox).
function(run_git out_var result_var)
  execute_process(COMMAND git -c core.quotePath=false --no-optional-locks ${ARGN}
                  WORKING_DIRECTORY "${SOURCE_DIR}"
                  OUTPUT_VARIABLE out
                  RESULT_VARIABLE result
                  ERROR_QUIET)
  set(${out_var} "${out}" PARENT_SCOPE)
  set(${result_var} "${result}" PARENT_SCOPE)
endfunction()

set(git_available false)
set(git_dirty false)
set(git_commit "unknown")
set(git_commit_date "unknown")
set(git_status "")
set(source_patch "")

run_git(commit result rev-parse HEAD)
if(result EQUAL 0)
  set(git_available true)
  string(STRIP "${commit}" git_commit)
  run_git(commit_date result log -1 --format=%cI HEAD)
  string(STRIP "${commit_date}" git_commit_date)

  # Every change git doesn't ignore counts, untracked files included.
  run_git(git_status result status --porcelain --untracked-files=all)
  if(NOT git_status STREQUAL "")
    set(git_dirty true)

    # Tracked changes (staged or not) against HEAD, then each untracked file as a new-file diff, so that
    # `git apply source.patch` on a checkout of git_commit reproduces the built tree.
    run_git(source_patch result diff HEAD)
    run_git(untracked result ls-files --others --exclude-standard)
    string(REPLACE "\n" ";" untracked "${untracked}")
    foreach(file IN LISTS untracked)
      if(NOT file STREQUAL "")
        # --no-index exits 1 when the files differ, which they always do here.
        run_git(file_patch result diff --no-index -- /dev/null "${file}")
        string(APPEND source_patch "${file_patch}")
      endif()
    endforeach()
  endif()
endif()

cmake_host_system_information(RESULT build_host QUERY HOSTNAME)

# The patch is embedded as bytes rather than a string literal: no escaping, and no literal-length limits.
string(HEX "${source_patch}" patch_hex)
string(LENGTH "${source_patch}" patch_size)
string(REGEX REPLACE "(..)" "0x\\1," patch_bytes "${patch_hex}")
string(REGEX REPLACE "((0x..,){24})" "\\1\n    " patch_bytes "${patch_bytes}")

to_cpp_literal("${git_commit}" git_commit_lit)
to_cpp_literal("${git_commit_date}" git_commit_date_lit)
to_cpp_literal("${git_status}" git_status_lit)
to_cpp_literal("${COMPILER}" compiler_lit)
to_cpp_literal("${CXX_FLAGS}" cxx_flags_lit)
to_cpp_literal("${BUILD_TYPE}" build_type_lit)
to_cpp_literal("${build_host}" build_host_lit)

set(content "// Generated by cmake/build_info.cmake on every build. Do not edit.
#include \"build_info/build_info.hpp\"

namespace Core::BuildInfo {

namespace {
// Trailing 0 so the array is never empty.
const unsigned char source_patch_bytes[] = {
    ${patch_bytes}0};
}  // namespace

const bool git_available = ${git_available};
const bool git_dirty = ${git_dirty};
const char* const git_commit = ${git_commit_lit};
const char* const git_commit_date = ${git_commit_date_lit};
const char* const git_status = ${git_status_lit};
const char* const compiler = ${compiler_lit};
const char* const cxx_flags = ${cxx_flags_lit};
const char* const build_type = ${build_type_lit};
const char* const build_host = ${build_host_lit};
const std::string_view source_patch(reinterpret_cast<const char*>(source_patch_bytes), ${patch_size});

}  // namespace Core::BuildInfo
")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old_content)
else()
  set(old_content "")
endif()
if(NOT content STREQUAL old_content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
